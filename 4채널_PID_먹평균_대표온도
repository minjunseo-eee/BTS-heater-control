TARGET_TEMP_C = 90.0  # 대푯온도 T_rep 의 목표값 (--target 으로 변경 가능)

# 멱평균 지수: 로그에는 항상 이 4개를 모두 기록, 제어에는 --p 로 고른 하나만 사용
P_LIST = [1, 2, 4, float("inf")]
P_CONTROL_DEFAULT = 2

# 제어 게인 (SIMC 튜닝값, 논문 2.3절과 일치시킬 것)
KP = 0.442
KI = KP / 68
KD = KP * 0.5

VOLTAGE_MAX = 24.0
VOLTAGE_MIN = 0.0

INTEGRAL_LIMIT = VOLTAGE_MAX / KI
CURRENT_LIMIT = 5.0

MAX_VOLTAGE_STEP_PER_LOOP = 2.0

# 안전 (항상 max 채널 기준)
DROP_TRIGGER_TEMP_C = 93.0
DROP_STEP_VOLTAGE = 1.0
HARD_SAFETY_CUTOFF_C = 95.0

LOG_INTERVAL_SECONDS = 2.0
MAX_TOTAL_SECONDS = 45 * 60

MAX_PLAUSIBLE_RATE_C_PER_S = 3.0
FAULT_CEILING_C = 150.0
WATCHDOG_TIMEOUT_SECONDS = 15.0

# 시작 전 주변온도 측정: 출력 OFF 상태에서 이 횟수만큼 읽어 중앙값 사용
AMBIENT_SAMPLES = 5

# 요약 통계에 사용할 "정상상태" 구간 길이(초): 종료 직전 이 시간
STEADY_WINDOW_S = 120.0

DEBUG = False  # True면 단계별 디버그 출력 (멈추는 지점 찾을 때만)

